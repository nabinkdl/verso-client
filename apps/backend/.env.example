# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database
# Pooled connection string (application traffic). Use the Neon "-pooler" host.
DATABASE_URL="postgresql://mononet:mononet@localhost:5432/mononet?schema=public"
# Direct (non-pooled) connection string, used for migrations. Use the Neon host without "-pooler".
DATABASE_URL_UNPOOLED="postgresql://mononet:mononet@localhost:5432/mononet?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Password reset email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Verso <onboarding@resend.dev>"
# Public URL of the UI, used to build the reset link.
APP_URL="http://localhost:5173"
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
