{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/vitest.config.e2e.ts"
    ],
    "sharedGlobals": ["{workspaceRoot}/package-lock.json"]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "db:generate": {
      "cache": true
    },
    "dev": { "cache": false },
    "serve": { "cache": false },
    "preview": { "cache": false },
    "start": { "cache": false },
    "start:prod": { "cache": false },
    "start:debug": { "cache": false },
    "test:watch": { "cache": false },
    "test:debug": { "cache": false },
    "test:e2e": { "cache": false },
    "format": { "cache": false },
    "db:migrate": { "cache": false },
    "db:deploy": { "cache": false },
    "db:seed": { "cache": false },
    "db:reset": { "cache": false },
    "db:studio": { "cache": false }
  },
  "plugins": []
}
