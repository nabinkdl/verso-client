# Docker Compose only. Copy to .env before `npm run docker:up`.
# The API's own secrets live in apps/backend/.env (see apps/backend/.env.example).
# Never commit .env or .neon.

# Neon pooler hostname without a protocol, e.g.
# ep-xxxx-pooler.c-6.us-east-2.aws.neon.tech
NEON_DB_HOST=

# A reachable IPv4 address for that hostname.
NEON_DB_IP=

# Public URL used by the container for APP_URL and CORS_ORIGIN.
PUBLIC_URL=http://localhost:3000
